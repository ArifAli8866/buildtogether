# ==============================================================================
# Build Together — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to source control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Keys (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Privileged Key (SERVER-ONLY — Never expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Master Encryption Key for User GitHub OAuth Tokens at Rest
# Must be a 32-byte hex string (64 characters). Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# GitHub OAuth App Credentials (for connecting user repositories)
# Configure in GitHub Developer Settings:
# Authorization callback URL: ${NEXT_PUBLIC_APP_URL}/api/github/callback (e.g. http://localhost:3000/api/github/callback)
# Webhook URL for user repositories: ${NEXT_PUBLIC_APP_URL}/api/github/webhooks (e.g. http://localhost:3000/api/github/webhooks)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"

